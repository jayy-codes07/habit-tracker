# The build context is the repository root, so this file replaces the old
# server/.dockerignore. The image needs server/ and — once it exists — web/;
# everything else is either a secret, a build output, or noise that would
# invalidate layer caching for nothing.

.git
.gitignore
.claude
.agents
skills-lock.json
README.md
docker-compose.yml
docker-compose.override.yml
.dockerignore
server/Dockerfile

# Never bake secrets into an image layer
.env
.env.*

# Installed inside the image, never copied in
node_modules
**/node_modules
npm-debug.log*

# Built inside the image by the web-build stage
web/dist
dist
build

# Not needed at runtime
server/tests
coverage

# Development data, and the one script in the tree that truncates every table.
# Nothing the server imports reaches it — `npm run db:seed` is a development
# command, and the development container bind-mounts server/ over /app, so it
# keeps working there. Shipping it meant the production image carried a
# one-command wipe of real data for no reason.
server/src/db/seeds
**/eslint.config.js
**/.prettierrc.json
**/.prettierignore

# Not needed to BUILD the SPA either. The web-build stage does `COPY web/ ./`,
# so without these an edit to an e2e spec invalidated that layer and paid for a
# full `vite build` — and `npm run build` is `vite build` alone, which neither
# lints nor typechecks, so none of it is reachable from the build.
web/e2e
web/playwright.config.ts
web/scripts
web/test-results
web/playwright-report
web/blob-report
**/*.tsbuildinfo
