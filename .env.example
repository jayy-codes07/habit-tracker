# Copy to .env and adjust. .env is gitignored.

NODE_ENV=development
PORT=3000

# --- Local Postgres (docker compose) ---
# These configure the local db container. Production uses a managed
# Postgres service instead of this container.
POSTGRES_USER=habit
POSTGRES_PASSWORD=habit_dev_password
POSTGRES_DB=habit_tracker
# Host port the db container is published on. Change if 5432 is taken.
POSTGRES_PORT=5432

# --- Database connection ---
# Used when running the server directly on the host (npm run dev in server/).
# docker compose overrides this to point at the "db" service hostname.
# In production, set this to your managed Postgres connection string.
DATABASE_URL=postgres://habit:habit_dev_password@localhost:5432/habit_tracker

# Managed Postgres providers require TLS. Set true in production.
DATABASE_SSL=false

# --- Authentication (single user) ---
# Generate the hash with:  cd server && npm run hash-password
# Only the hash belongs here. The plaintext password is never stored anywhere.
AUTH_PASSWORD_HASH=

# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters. Changing it signs every existing session out.
SESSION_SECRET=

# How long a login lasts, in days. Long enough not to nag on a phone, short
# enough that a stolen cookie is not permanent.
SESSION_TTL_DAYS=30
