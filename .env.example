# Copy to .env and adjust. .env is gitignored.

NODE_ENV=development
PORT=3000

# The calendar day the app lives in, as an IANA time zone. A habit is done on a
# day, not at an instant, so this decides when "today" rolls over. The container
# runs UTC; set this to where you actually are or streaks read wrongly for part
# of every day. Defaults to UTC.
APP_TIMEZONE=UTC

# --- Local Postgres (docker compose) ---
# These configure the local db container. Production uses a managed
# Postgres service instead of this container.
POSTGRES_USER=habit
POSTGRES_PASSWORD=habit_dev_password
POSTGRES_DB=habit_tracker
# Host port the db container is published on. Change if 5432 is taken.
POSTGRES_PORT=5432

# --- Database connection ---
# Used when running the server directly on the host (npm run dev in server/).
# docker compose overrides this to point at the "db" service hostname.
# In production, set this to your managed Postgres connection string.
DATABASE_URL=postgres://habit:habit_dev_password@localhost:5432/habit_tracker

# Managed Postgres providers require TLS. Set true in production.
DATABASE_SSL=false

# --- Authentication (single user) ---
# Generate the hash with:  cd server && npm run hash-password
# Only the hash belongs here. The plaintext password is never stored anywhere.
AUTH_PASSWORD_HASH=

# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters. Changing it signs every existing session out.
SESSION_SECRET=

# How long a login lasts, in days. Long enough not to nag on a phone, short
# enough that a stolen cookie is not permanent.
SESSION_TTL_DAYS=30

# --- Cloudinary (LeetCode screenshots) ---
# The media store. Postgres keeps only the asset reference; the bytes live here.
# Every upload and delete is signed and server-side, so these three values are
# server-side only - none of them is ever sent to the browser.
# From the Cloudinary dashboard: Settings -> API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Web Push (reminders) ---
# The reminder scheduler pushes to the browser's own push service, so a
# notification arrives with the app closed. No SaaS is involved: VAPID is just
# a key pair identifying this server to that push service.
#
# Generate the pair once with:  cd server && npm run vapid
# Then paste both lines here. Keep them: changing the pair invalidates every
# subscription already made, and each device has to be registered again.
#
# The PUBLIC key is deliberately sent to the browser - it is what a subscription
# is signed to. The PRIVATE key signs every send and never leaves the server.
# Leave both blank and the app runs normally, simply without sending anything.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# A contact the push service can use if this server misbehaves. Required by the
# VAPID spec; a mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com

# How often the server looks for reminders that have come due, in seconds.
# A minute is the resolution a reminder time is set at; below 15s is ignored.
REMINDER_TICK_SECONDS=120
